### Variables
@API_URL = http://localhost:8080

###
# No Authorization Header
# Expected: 401 Unauthenticated - "missing authorization header"
POST {{API_URL}}/garden.v2.GardenService/GetSummary HTTP/1.1
Content-Type: application/json

{}

###
# Invalid Token
# Expected: 401 Unauthenticated - token validation failed
POST {{API_URL}}/garden.v2.GardenService/GetSummary HTTP/1.1
Content-Type: application/json
Authorization: Bearer invalid_token_here

{}

###
# Malformed Bearer Token
# Expected: 401 Unauthenticated
POST {{API_URL}}/garden.v2.GardenService/GetSummary HTTP/1.1
Content-Type: application/json
Authorization: NotBearer xyz123

{}

###
# User Trying to Insert (should fail - permission denied)
# Expected: 403 Permission Denied - "only hub can insert data"
# Requires USER_TOKEN - run Register/Login in 01-auth.http first
POST {{API_URL}}/garden.v2.GardenService/InsertSensorData HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{USER_TOKEN}}

{
  "node_id": "sensor-unauthorized",
  "temperature": 99.9,
  "humidity": 99.9,
  "soil_moisture": 99.9
}
