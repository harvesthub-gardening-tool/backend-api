### Variables
@API_URL = http://localhost:8080

###
# Register New User
# Creates a new user account with email and password
# Captures USER_TOKEN automatically for use in subsequent requests
POST {{API_URL}}/auth.v1.AuthService/Register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "SecurePass123!"
}

> {%
# @lang=lua
local json = vim.json.decode(response.body)
if json and json.token then
  client.global.set("USER_TOKEN", json.token)
end
%}

###
# Register Another User (for testing multiple accounts)
POST {{API_URL}}/auth.v1.AuthService/Register
Content-Type: application/json

{
  "email": "alice@example.com",
  "password": "AlicePass456!"
}

###
# Login
# Authenticates an existing user
# Captures USER_TOKEN automatically for use in subsequent requests
POST {{API_URL}}/auth.v1.AuthService/Login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "SecurePass123!"
}

> {%
# @lang=lua
local json = vim.json.decode(response.body)
if json and json.token then
  client.global.set("USER_TOKEN", json.token)
end
%}

###
# Login with Wrong Password (should fail)
POST {{API_URL}}/auth.v1.AuthService/Login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "WrongPassword!"
}

###
# Login with Non-existent User (should fail)
POST {{API_URL}}/auth.v1.AuthService/Login
Content-Type: application/json

{
  "email": "nonexistent@example.com",
  "password": "SomePassword123!"
}

###
# Create Hub Token
# Generates a service account token for a hub device
# Captures HUB_TOKEN automatically for use in insert-sensor-data requests
POST {{API_URL}}/auth.v1.AuthService/CreateHubToken
Authorization: Bearer {{USER_TOKEN}}
Content-Type: application/json

{
  "hub_name": "garden-hub-1"
}

> {%
# @lang=lua
local json = vim.json.decode(response.body)
if json and json.token then
  client.global.set("HUB_TOKEN", json.token)
end
%}

###
# Create Another Hub Token
# Multiple hubs per user are supported
POST {{API_URL}}/auth.v1.AuthService/CreateHubToken
Authorization: Bearer {{USER_TOKEN}}
Content-Type: application/json

{
  "hub_name": "greenhouse-hub"
}

###
# Create Hub Token Without Auth (should fail)
POST {{API_URL}}/auth.v1.AuthService/CreateHubToken
Content-Type: application/json

{
  "hub_name": "unauthorized-hub"
}

###
# List Hub Tokens
# Shows all hub tokens for the authenticated user
POST {{API_URL}}/auth.v1.AuthService/ListHubTokens
Authorization: Bearer {{USER_TOKEN}}
Content-Type: application/json

{}

###
# List Hub Tokens Without Auth (should fail)
POST {{API_URL}}/auth.v1.AuthService/ListHubTokens
Content-Type: application/json

{}

###
# Revoke Hub Token
# Replace token_id with actual ID from ListHubTokens response
POST {{API_URL}}/auth.v1.AuthService/RevokeHubToken
Authorization: Bearer {{USER_TOKEN}}
Content-Type: application/json

{
  "token_id": "1"
}

###
# Revoke Non-existent Token (should fail)
POST {{API_URL}}/auth.v1.AuthService/RevokeHubToken
Authorization: Bearer {{USER_TOKEN}}
Content-Type: application/json

{
  "token_id": "99999"
}

###
# Revoke Without Auth (should fail)
POST {{API_URL}}/auth.v1.AuthService/RevokeHubToken
Content-Type: application/json

{
  "token_id": "1"
}
