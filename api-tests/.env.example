# API Configuration
API_URL=http://localhost:8080

# Service Account Token (Hub)
# Get from Zitadel: create service account → generate token
HUB_TOKEN=

# User Token
# Get from Zitadel: login as user → copy JWT from OAuth flow
USER_TOKEN=

# Optional: Zitadel Admin
# Default: root / RootPassword1!
ZITADEL_URL=http://localhost:8085
