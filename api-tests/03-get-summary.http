### Variables
@API_URL = http://localhost:8080

###
# SETUP INSTRUCTIONS:
# 1. Run 01-auth.http to register/login and get a USER_TOKEN
# 2. Replace YOUR_USER_TOKEN_HERE below with the actual token
# 3. Optionally, create a hub token via CreateHubToken for hub token tests

###
# Get Summary - Default (24 hours, all nodes)
# Requires: Any authenticated token (user or hub token)
POST {{API_URL}}/garden.v1.GardenService/GetSummary HTTP/1.1
Content-Type: application/json
Authorization: Bearer YOUR_USER_TOKEN_HERE

{}

###
# Get Summary - Specific Node
POST {{API_URL}}/garden.v1.GardenService/GetSummary HTTP/1.1
Content-Type: application/json
Authorization: Bearer YOUR_USER_TOKEN_HERE

{
  "node_id": "sensor-01"
}

###
# Get Summary - Custom Time Window (6 hours)
POST {{API_URL}}/garden.v1.GardenService/GetSummary HTTP/1.1
Content-Type: application/json
Authorization: Bearer YOUR_USER_TOKEN_HERE

{
  "hours": 6
}

###
# Get Summary - Specific Node + Custom Hours
POST {{API_URL}}/garden.v1.GardenService/GetSummary HTTP/1.1
Content-Type: application/json
Authorization: Bearer YOUR_USER_TOKEN_HERE

{
  "node_id": "sensor-02",
  "hours": 12
}

###
# Get Summary with Hub Token (should work)
# Hub tokens can also read data
POST {{API_URL}}/garden.v1.GardenService/GetSummary HTTP/1.1
Content-Type: application/json
Authorization: Bearer YOUR_HUB_TOKEN_HERE

{
  "node_id": "sensor-01",
  "hours": 24
}

###
# Get Summary - 1 hour window
POST {{API_URL}}/garden.v1.GardenService/GetSummary HTTP/1.1
Content-Type: application/json
Authorization: Bearer YOUR_USER_TOKEN_HERE

{
  "hours": 1
}
