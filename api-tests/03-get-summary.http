###
# Get Summary - Default (24 hours, all nodes)
# Requires: Any authenticated token (user or service account)
POST {{API_URL}}/garden.v1.GardenService/GetSummary HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{USER_TOKEN}}

{}

###
# Get Summary - Specific Node
POST {{API_URL}}/garden.v1.GardenService/GetSummary HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{USER_TOKEN}}

{
  "node_id": "sensor-01"
}

###
# Get Summary - Custom Time Window (6 hours)
POST {{API_URL}}/garden.v1.GardenService/GetSummary HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{USER_TOKEN}}

{
  "hours": 6
}

###
# Get Summary - Specific Node + Custom Hours
POST {{API_URL}}/garden.v1.GardenService/GetSummary HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{USER_TOKEN}}

{
  "node_id": "sensor-02",
  "hours": 12
}

###
# Get Summary with Service Account Token (should work)
# Tests that service accounts can also read data
POST {{API_URL}}/garden.v1.GardenService/GetSummary HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{HUB_TOKEN}}

{
  "node_id": "sensor-01",
  "hours": 24
}

###
# Get Summary - 1 hour window
POST {{API_URL}}/garden.v1.GardenService/GetSummary HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{USER_TOKEN}}

{
  "hours": 1
}
