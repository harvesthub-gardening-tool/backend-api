### Variables
@API_URL = http://localhost:8080

###
# SETUP INSTRUCTIONS:
# 1. Run 01-auth.http to register/login and get a USER_TOKEN
# 2. Use that USER_TOKEN to call CreateHubToken in 01-auth.http
# 3. Copy the hub JWT token from the response
# 4. Replace YOUR_HUB_TOKEN_HERE below with the actual hub token

###
# Insert Sensor Data - Basic
# Requires: Hub service account token (empty username in JWT)
POST {{API_URL}}/garden.v1.GardenService/InsertSensorData HTTP/1.1
Authorization: Bearer YOUR_HUB_TOKEN_HERE
Content-Type: application/json

{
  "node_id": "sensor-01",
  "temperature": 22.5,
  "humidity": 65.0,
  "soil_moisture": 45.0,
  "timestamp": 1698765432000
}

###
# Insert Sensor Data - Without Timestamp (defaults to now)
POST {{API_URL}}/garden.v1.GardenService/InsertSensorData HTTP/1.1
Authorization: Bearer YOUR_HUB_TOKEN_HERE
Content-Type: application/json

{
  "node_id": "sensor-02",
  "temperature": 18.0,
  "humidity": 70.0,
  "soil_moisture": 50.0,
  "timestamp": 0
}

###
# Insert Sensor Data - Multiple nodes
POST {{API_URL}}/garden.v1.GardenService/InsertSensorData HTTP/1.1
Authorization: Bearer YOUR_HUB_TOKEN_HERE
Content-Type: application/json

{
  "node_id": "sensor-03",
  "temperature": 25.3,
  "humidity": 55.0,
  "soil_moisture": 60.0,
  "timestamp": 1698765500000
}

###
# Insert with User Token (should fail - permission denied)
# Only hub tokens (service accounts) can insert sensor data
# Get USER_TOKEN from Register or Login in 01-auth.http
POST {{API_URL}}/garden.v1.GardenService/InsertSensorData HTTP/1.1
Authorization: Bearer YOUR_USER_TOKEN_HERE
Content-Type: application/json

{
  "node_id": "sensor-99",
  "temperature": 20.0,
  "humidity": 60.0,
  "soil_moisture": 40.0
}
