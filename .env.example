# Backend API — copy to .env and fill in real values
# In production (Dokploy), set these via the environment panel instead.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# User that owns the database
POSTGRES_USER=postgres

# Strong password — change this in production!
POSTGRES_PASSWORD=changeme

# Database name
POSTGRES_DB=garden_db

# ── API ──────────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string (must match the values above)
# Format: postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>?sslmode=disable
DATABASE_URL=postgres://postgres:changeme@db:5432/garden_db?sslmode=disable

# Directory where RSA key files are persisted (.jwt_private.pem / .jwt_public.pem).
# Keys are auto-generated on first run and reused on restart to keep hub tokens valid.
# In production, mount a persistent volume and point this to it (e.g. /keys).
JWT_KEY_PATH=.

# ── AI assistant (Mistral) ───────────────────────────────────────────────────
# Server-side only. Never expose this value to mobile clients or commit real keys.
MISTRAL_API_KEY=replace-with-mistral-api-key
MISTRAL_AGENT_ID=replace-with-mistral-agent-id
MISTRAL_AGENT_VERSION=1
# Optional override for tests/proxies. Leave empty for https://api.mistral.ai.
MISTRAL_BASE_URL=
