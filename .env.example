# Backend API
DATABASE_URL=postgres://user:password@db:5432/garden_db?sslmode=disable

# Zitadel Configuration
ZITADEL_DOMAIN=localhost:8085
ZITADEL_KEY_PATH=./zitadel-key.json
ZITADEL_DATABASE_URL=postgres://user:password@db:5432/zitadel_db?sslmode=disable
ZITADEL_MASTERKEY=

# Hub Service Account
HUB_SERVICE_ACCOUNT_ID=

# Production overrides (uncomment for production)
# ZITADEL_EXTERNALSECURE=true
# ZITADEL_DOMAIN=auth.harvesthub.com
