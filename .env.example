# Backend API — copy to .env and adjust for your environment

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@db:5432/garden_db?sslmode=disable

# Directory where RSA key files (.jwt_private.pem / .jwt_public.pem) are stored.
# Keys are auto-generated on first run and reused on restart to keep hub tokens valid.
# Use an absolute path or volume mount in production.
JWT_KEY_PATH=.
